rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ummihasya@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin'
      );
    }

    function isAssignedTeacher(classId, className) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'teacher' &&
        (
          (getUserData().assignedClasses != null && (classId in getUserData().assignedClasses || className in getUserData().assignedClasses))
        );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // CLASSES COLLECTION
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }

    // STUDENTS COLLECTION
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }

    // ATTENDANCE COLLECTION
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false; // Soft-delete only via update (isDeleted: true)
    }

    // WARNING LETTERS COLLECTION
    match /warningLetters/{warningId} {
      allow read: if isSignedIn();
      // Admin and teachers can record / edit warning letter dates
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // AUDIT LOGS COLLECTION
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }

    // SETTINGS COLLECTION
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // CONNECTION TEST
    match /test/{docId} {
      allow read: if true;
    }
  }
}
